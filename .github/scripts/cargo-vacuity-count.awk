# >>> CARGO_VACUITY_AWK v1 (source of record: qontinui-claude-config/scripts/lib/cargo-vacuity.sh) >>>
{
  line = $0
  gsub(/\033\[[0-9;]*[a-zA-Z]/, "", line)
  if (line ~ /test result:/) {
    n = split(line, w, /[ \t]+/)
    for (i = 1; i < n; i++) {
      if (w[i+1] ~ /^passed/) ran += w[i] + 0
      if (w[i+1] ~ /^failed/) ran += w[i] + 0
    }
    summaries++
  } else if (line ~ /Summary \[/ && line ~ /tests? run:/) {
    if (match(line, /[0-9]+ tests? run:/)) ran += substr(line, RSTART, RLENGTH) + 0
    summaries++
  }
}
END { printf "%d %d\n", ran + 0, summaries + 0 }
