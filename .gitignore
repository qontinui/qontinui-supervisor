/target
/target-test
/target-pool
*.exe
*.pdb
.env
/dist
/frontend/node_modules
.worktrees/
/target-agent
/target-substrate
agent-worktrees/

# coord-mcp device credential (nonce/JWT) is written into the worktree as
# .mcp.json at launch. It is a live credential and must never be committed.
# (Was previously only in .git/info/exclude — local-only, lost on fresh clone/CI.)
.mcp.json

# MSYS/Cygwin crash dumps (bash.exe.stackdump, du.exe.stackdump, ...).
# Build-environment noise on Windows dev boxes, never source.
*.stackdump

# Python bytecode from scripts/*.py. Interpreter-version-specific and it churns
# on every run, so it conflicts across machines; two .pyc files reached the
# index before this entry existed.
__pycache__/
*.py[cod]

# Claude Code's per-repo scaffolding: fleet-wide slash commands (canonical copy
# lives in qontinui-claude-config/.claude/commands/) plus .claude/worktrees/.
# Machine-local, never source — and every peer repo already ignores it
# (qontinui-runner, -coord, -web, -schemas, ...). Left untracked here it made
# `git status --porcelain` non-empty, so dev-start.ps1's
# Resolve-PrimaryTreeStaleness read the tree as WIP and skipped its
# `merge --ff-only origin/main` — the supervisor sat 26 commits behind main for
# weeks because of two stale command files.
.claude/

# The rest of the runner's machine-local artifact roster. That roster is
# enumerated in code — qontinui-runner `src-tauri/src/fleet.rs`,
# MANAGED_REPO_EXCLUDES — and has exactly four entries. `agent-worktrees/`
# (line 12) and `.mcp.json` (line 17) above are two of them; these are the two
# the earlier promotions left behind:
#
#   .agent-worktrees/  the dot-prefixed container. `agent-worktrees/` above does
#                      NOT match it — a gitignore pattern matches a path
#                      component literally, and `.agent-worktrees` is a
#                      different name. No repo in the workspace has promoted
#                      this one; it lives only in `.git/info/exclude`.
#   .coord-mcp-status  the runner's one-line, spawn-time record that coord-mcp
#                      provisioning was DEGRADED. Status, not source.
#                      qontinui-claude-config promoted this one already
#                      (its .gitignore line 30 on origin/main).
#
# Same rationale the `.mcp.json` entry above states for itself: the runner
# writes these into `.git/info/exclude`, which is local-only and lost on a
# fresh clone / in CI, and it writes them best-effort — `ensure_repo_info_exclude`
# swallows every IO error. A tracked entry is the durable statement.
#
# Not cosmetic: `git status --porcelain` counts untracked files, so any one of
# these left unignored makes dev-start.ps1's Resolve-PrimaryTreeStaleness read a
# clean tree as WIP and skip its `merge --ff-only origin/main` — the defect that
# held this repo 26 commits behind main (see the `.claude/` entry above, #166).
.agent-worktrees/
.coord-mcp-status
